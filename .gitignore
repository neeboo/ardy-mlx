__pycache__/
*.pyc
.venv/
datasets/*
!datasets/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
out/
.DS_Store

# ---------------------------------------------------------------------------
# Weight-derived data: never committed, wherever it lives.
#
# This is a blanket rule on purpose. `artifacts/golden-run*/{raw,out}` have their
# own .gitignore files, but a rule that only covers the paths we happened to
# think of is how a 16 KB embedding or a 90 KB reference clip ends up in a
# commit. The audit is:
#
#   git ls-files | grep -E '\.(safetensors|npz|npy)$|golden-run[^/]*/(raw|out)/'
#
# and it must print nothing.
# ---------------------------------------------------------------------------
*.npz
*.npy
*.safetensors

# The viewer's cached text embeddings (artifacts/embeddings/<prompt-hash>.npy).
# Documented in embeddings/README.md; regenerated on the reference machine.
artifacts/embeddings/*
!artifacts/embeddings/.gitkeep

# ---------------------------------------------------------------------------
# Action clips: the motion itself is weight-derived, so it is never committed.
#
# `*.npz` above already covers the clip files; these two lines name the
# directory explicitly so the intent survives a future edit to that blanket
# rule, and so `git status` stays clean while `scripts/ardy_actions.py` runs.
# Committed from this directory: manifest.json, foot-skating.json, preview.gif,
# preview.json, text-vectors.json, prompts.txt, README.md.
# ---------------------------------------------------------------------------
artifacts/action-clips/raw/
artifacts/action-clips/_gif-frames/

